{
  "name": "flue-codex-oauth",
  "version": "1.0.0",
  "description": "Codex subscription OAuth for Flue 2 agents with file-based credentials and request-time token refresh.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhruvkelawala/flue-codex-oauth.git"
  },
  "keywords": [
    "flue",
    "codex",
    "oauth",
    "openai",
    "agent"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "flue-codex-login": "dist/bin/login.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "example:check": "pnpm -C examples/basic install && pnpm -C examples/basic typecheck",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build && pnpm example:check"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@flue/runtime": "^2.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.83.0"
  },
  "devDependencies": {
    "@flue/runtime": "^2.0.0",
    "typescript": "^5",
    "vitest": "^3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
